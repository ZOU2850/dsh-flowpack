{
  "name": "dsh-flowpack",
  "version": "2.0.0",
  "description": "Human-like progressive AI workflow learning, selectable cross-conversation/cross-agent Experience Capsules with runtime self-healing & non-forgetting genealogy, and SHA-256 strict memory packaging for DeepSeek Harness (DSH).",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "files": [
    "README.md",
    "README.zh.md",
    "LICENSE",
    "cordis.patch.yml",
    "icon.svg",
    "locale",
    "index.js",
    "client.js",
    "lib",
    "install-profile.ps1",
    "install.cmd"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "engines": {
    "dsh": ">=0.2.0-rc.1",
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "workflow",
    "optimization",
    "memory-pack",
    "compaction",
    "verification"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  }
}
